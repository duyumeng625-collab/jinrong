# LLM provider (required for AI chat)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Local storage
RAG_DB_PATH=./data/rag.sqlite3
FAISS_INDEX_PATH=./data/faiss
APP_DATABASE_URL=
# Leave APP_DATABASE_URL empty to use the local SQLite default. To use MySQL,
# set SQL_DB_HOST, SQL_DB_PORT, SQL_DB_USER, SQL_DB_PASSWORD, and SQL_DB_NAME.
SQL_DB_HOST=
SQL_DB_PORT=3306
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_DB_NAME=
# Optionally set APP_DATABASE_URL=mysql+pymysql://user:password@host:3306/database?charset=utf8mb4
# RAG uses the same MySQL URL by default; set RAG_DATABASE_URL to override it.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Optional Redis ACL username or a complete REDIS_URL override.
REDIS_USERNAME=
# REDIS_URL=redis://:password@localhost:6379/2
HOST=127.0.0.1
PORT=8000
ADMIN_API_KEY=replace-with-a-long-random-secret-for-internal-knowledge-management

# Tracing is disabled in this project configuration.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
